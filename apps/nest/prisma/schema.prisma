// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        BigInt  @id @default(autoincrement())
  profileId BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  username         String
  name             String?
  password         String?
  jwtValidFrom     DateTime     @default(now()) // support revoke token
  confirmationHash String?
  provider         UserProvider // username, email, apple, google...
  profile          Profile?     @relation(fields: [profileId], references: [id])
  lastLoginAt      DateTime?
  blocked          Boolean      @default(false)
  confirmed        Boolean      @default(false)
  role             Role         @default(USER)

  verifyCode      String?   @unique
  verifyCodeCount Int       @default(0)
  verifyCreatedAt DateTime?

  walletAddress String? @unique
  /**
   * Network identifier for blockchain networks. For networks that don't have a standard chainId
   * (such as Solana, Sui, etc.), the networkId values will be self-defined within this project.
   */
  networkId Int? 

  // Game relations
  gamePlayers GamePlayer[]

  // relations
  @@unique([username, provider])
}

enum UserProvider {
  USERNAME
  LOCAL // email
  google
  apple
  facebook
  wallet
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

model Profile {
  id BigInt @id @default(autoincrement())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  dob       DateTime?

  name          String
  avatar        String?
  email         String?

  // relations
  users User[]
  todos Todo[]
}

enum TodoStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Todo {
  id BigInt @id @default(autoincrement())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String?
  status      TodoStatus @default(TODO)

  profileId BigInt
  profile   Profile @relation(fields: [profileId], references: [id])
}

// ============================================
// LUCKY ENVELOPE GAME MODELS
// ============================================

enum GameRoomStatus {
  WAITING    // Waiting for players to join
  PLAYING    // Game in progress
  FINISHED   // Game completed
  CANCELLED  // Game cancelled (not enough players, etc.)
}

enum GamePhase {
  WAITING_FOR_PLAYERS  // Room created, waiting for 4 players
  SELECTING_ENVELOPE   // Players are selecting envelopes in turn
  REVEALING            // Revealing which envelope is eliminated
  VOTING               // Players voting to split or continue (future feature)
  ROUND_END            // Round completed, preparing next round
  GAME_OVER            // Game finished
}

enum Envelope {
  A
  B
  C
  D
}

// Main game room
model GameRoom {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Room identification
  code String @unique @db.VarChar(6) // 6-character room code

  // Game state
  status       GameRoomStatus @default(WAITING)
  currentPhase GamePhase      @default(WAITING_FOR_PLAYERS)

  // Prize pool (in cents to avoid floating point issues)
  totalPrizeCents    Int @default(2800) // $28.00 = 2800 cents
  remainingPrizeCents Int @default(2800)

  // Current round info (1-3)
  currentRound     Int       @default(0) // 0 = not started, 1-3 = active rounds
  currentTurnIndex Int       @default(0) // Which player's turn (0-3)
  turnDeadline     DateTime? // When current turn expires (1 minute limit)

  // Winner (set when game ends)
  winnerId BigInt?
  winner   GamePlayer? @relation("GameWinner", fields: [winnerId], references: [id])

  // Relations
  players GamePlayer[]
  rounds  GameRound[]

  @@index([code])
  @@index([status])
}

// Players in a game room
model GamePlayer {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId BigInt
  user   User   @relation(fields: [userId], references: [id])

  // Player info
  displayName   String
  walletAddress String? // For prize distribution via smart contract

  // Room association
  roomId BigInt
  room   GameRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  isEliminated Boolean @default(false)
  eliminatedAt DateTime?

  // Current round turn order (randomized each round, 0-3)
  turnOrder Int @default(0)


  // Relations
  selectionsAsSelectorRound GameRoundSelection[] @relation("Selector")
  selectionsAsReceiverRound GameRoundSelection[] @relation("Receiver")
  eliminatedInRounds        GameRound[]          @relation("EliminatedPlayer")
  wonGames                  GameRoom[]           @relation("GameWinner")

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}

// Game round (1 round per elimination)
model GameRound {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Room association
  roomId BigInt
  room   GameRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  // Round info
  roundNumber Int // 1, 2, or 3

  // Turn order for this round (JSON array of player IDs in order)
  turnOrder String @db.Text // JSON: ["playerId1", "playerId2", ...]

  // Elimination result
  eliminatedEnvelope Envelope?
  eliminatedPlayerId BigInt?
  eliminatedPlayer   GamePlayer? @relation("EliminatedPlayer", fields: [eliminatedPlayerId], references: [id])

  // Prize for eliminated player (in cents)
  eliminationPrizeCents Int @default(0) // Round 1: $1, Round 2: $2, Round 3: $3

  // Round status
  isCompleted Boolean   @default(false)
  completedAt DateTime?

  // Relations
  selections GameRoundSelection[]

  @@unique([roomId, roundNumber])
  @@index([roomId])
}

// Envelope selection during a round
model GameRoundSelection {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now())

  // Round association
  roundId BigInt
  round   GameRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  // Selection info
  selectorId BigInt      // Player who made the selection
  selector   GamePlayer  @relation("Selector", fields: [selectorId], references: [id])
  
  receiverId BigInt      // Player who receives the envelope
  receiver   GamePlayer  @relation("Receiver", fields: [receiverId], references: [id])

  envelope Envelope // Which envelope (A, B, C, D)

  // Selection order (0 = first, 1 = second, etc.)
  selectionOrder Int

  // Was this auto-selected due to timeout?
  isAutoSelected Boolean @default(false)

  @@unique([roundId, selectorId])
  @@unique([roundId, receiverId])
  @@unique([roundId, envelope])
  @@index([roundId])
}
